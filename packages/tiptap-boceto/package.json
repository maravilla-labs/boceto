{
  "name": "@boceto/tiptap",
  "version": "0.2.0",
  "description": "TipTap node + extension for embedding Boceto wireframes (with cross-block component context) in any TipTap editor.",
  "license": "MIT",
  "author": "Maravilla Labs",
  "homepage": "https://maravilla-labs.github.io/boceto/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maravilla-labs/boceto.git",
    "directory": "packages/tiptap-boceto"
  },
  "bugs": {
    "url": "https://github.com/maravilla-labs/boceto/issues"
  },
  "keywords": [
    "boceto",
    "wireframe",
    "tiptap",
    "prosemirror",
    "editor"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./assets/boceto-icon.svg": "./src/assets/boceto-icon.svg"
  },
  "files": [
    "dist",
    "src/assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@boceto/core": "workspace:*",
    "@boceto/edit": "workspace:*",
    "@boceto/view": "workspace:*"
  },
  "devDependencies": {
    "@tiptap/core": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
