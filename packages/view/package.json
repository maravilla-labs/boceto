{
  "name": "@boceto/view",
  "version": "0.1.0",
  "description": "Read-only <boceto-view> web component.",
  "license": "MIT",
  "author": "Maravilla Labs",
  "homepage": "https://maravilla-labs.github.io/boceto/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maravilla-labs/boceto.git",
    "directory": "packages/view"
  },
  "bugs": {
    "url": "https://github.com/maravilla-labs/boceto/issues"
  },
  "keywords": ["boceto", "wireframe", "web-components", "custom-elements", "markdown", "remark", "markdown-it"],
  "type": "module",
  "sideEffects": ["**/auto.*"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@boceto/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
