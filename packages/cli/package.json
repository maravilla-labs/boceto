{
  "name": "boceto",
  "version": "0.1.0",
  "description": "Unified install + configure CLI for Boceto. `npx boceto init` wires up the authoring skill and the MCP server for your AI tools in one go; `npx boceto add skill <target>` and `npx boceto add mcp <client>` are the per-integration commands. Mirrors the Svelte `sv add` pattern.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "boceto": "./bin/boceto.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [
    "boceto",
    "cli",
    "skill",
    "mcp",
    "ai-tools",
    "claude",
    "cursor",
    "cline",
    "aider"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@boceto/skill": "workspace:*",
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maravilla-labs/boceto.git",
    "directory": "packages/cli"
  }
}
